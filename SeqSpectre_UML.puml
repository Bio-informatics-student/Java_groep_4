@startuml SeqSpectre_UML

title SeqSpectre - UML Class Diagram

left to right direction

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 55

hide empty members

' =========================
' MAIN
' =========================

class Main {
    - input : Path
    - output : Path
    - endPercent : double
    - requiredReadsPercent : double
    - maxDuplicatePercent : double
    - minQualityScore : int
    + run() : void
    + {static} main(String[]) : void
}

interface Runnable
Main ..|> Runnable

' =========================
' INPUT PACKAGE
' =========================

package "input" #E8F4FD {

    class InputController {
        - inputHandler : InputHandler
        - processor : FastqQCProcessor
        + InputController()
        + handleInput(Path, double, double, double, int) : List<QCResult>
        - isFastq(Path) : boolean
    }

    class InputHandler {
        - fastqFiles : List<Path>
        - samFiles : List<Path>
        - bamFiles : List<Path>
        - fastqcFiles : List<Path>
        + scanFolder(String) : void
        + getFastqFiles() : List<Path>
        + getSamFiles() : List<Path>
        + getBamFiles() : List<Path>
        + getFastqcFiles() : List<Path>
    }

    class FastQReader {
        + read(Path) : List<String[]>
        - openReader(Path) : BufferedReader
    }

    class SamReader {
        + read(Path) : Object
    }

    class BamReader {
        + read(Path) : Object
    }

    class FastQCReader {
        + read(Path) : Object
    }
}

' =========================
' PROCESSING PACKAGE
' =========================

package "processing" #EAF7EA {

    class FastqQCProcessor {
        - reader : FastQReader
        - qualityAnalyzer : AnalyseReadQuality
        - duplicateCalculator : DuplicateCalculator
        + FastqQCProcessor()
        + process(Path, double, double, double) : QCResult
        + process(Path, double, double, double, int) : QCResult
        - calculatePercentageAtLeast(String, int, int, int) : double
    }

    class AnalyseReadQuality {
        + calculateBaseCount(int, double) : int
        + analyse(String, String, double) : QualityResult
        - validatePercentage(double) : void
        - calculateStatistics(int[]) : QualityResult.EndQuality
        - classify(double, double) : String
    }

    class DuplicateCalculator {
        + calculateDuplicates(String[]) : double
    }

    class DataHandler {
        + dataHandler(List<List<String>>, boolean) : Map<String, List<String>>
    }

    class QualityResult {
        - percentage : double
        - readLength : int
        - basesPerEnd : int
        - start : EndQuality
        - end : EndQuality
        + QualityResult(double, int, int, EndQuality, EndQuality)
        + getPercentage() : double
        + getReadLength() : int
        + getBasesPerEnd() : int
        + getStart() : EndQuality
        + getEnd() : EndQuality
    }

    class "QualityResult.EndQuality" as EndQuality {
        - meanQuality : double
        - medianQuality : double
        - minimumQuality : int
        - percentageQ20 : double
        - percentageQ30 : double
        - meanErrorProbability : double
        - classification : String
        + EndQuality(double, double, int, double, double, double, String)
        + getMeanQuality() : double
        + getMedianQuality() : double
        + getMinimumQuality() : int
        + getPercentageQ20() : double
        + getPercentageQ30() : double
        + getMeanErrorProbability() : double
        + getClassification() : String
    }

    class InvalidReadException {
        + InvalidReadException(String)
    }
}

class RuntimeException
InvalidReadException --|> RuntimeException

' =========================
' OUTPUT PACKAGE
' =========================

package "output" #FFF2E2 {

    class QCResult {
        - sample : String
        - fileType : String
        - beginningQuality : Double
        - endQuality : Double
        - duplicates : Double
        - status : String
        + QCResult(String, String, Double, Double, Double, String)
        + getSample() : String
        + getFileType() : String
        + getBeginningQuality() : Double
        + getEndQuality() : Double
        + getDuplicates() : Double
        + getStatus() : String
    }

    class OutputWriter {
        + printToTerminal(List<QCResult>) : void
        + writeToFile(List<QCResult>, Path) : void
        - formatResult(QCResult) : String
        - formatPercentage(Double) : String
    }
}

' =========================
' RELATIONSHIPS
' =========================

' Main application flow
Main ..> InputController : uses
Main ..> OutputWriter : uses

' Input handling
InputController --> InputHandler : has
InputController --> FastqQCProcessor : has
InputController ..> FastQReader : indirectly uses via processor

' FASTQ processing pipeline
FastqQCProcessor --> FastQReader : reads FASTQ records
FastqQCProcessor --> AnalyseReadQuality : analyses read ends
FastqQCProcessor --> DuplicateCalculator : calculates duplicates
FastqQCProcessor ..> QCResult : creates

' Quality analysis
AnalyseReadQuality ..> QualityResult : creates
AnalyseReadQuality ..> EndQuality : creates
QualityResult "1" *-- "2" EndQuality : start / end statistics

' Legacy/general FASTQ validation helper; not used by current FastqQCProcessor flow
DataHandler ..> InvalidReadException : throws

' Output
OutputWriter ..> QCResult : formats and writes

@enduml
