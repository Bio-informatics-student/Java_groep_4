@startuml SeqSpectre_UML

title SeqSpectre - UML Class Diagram

left to right direction

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 55

hide empty members

' =========================
' MAIN
' =========================

class Main {
    - input : Path
    - output : Path
    + run() : void
    - {static} isSupportedFile(Path) : boolean
    - {static} getFileType(Path) : String
    + {static} main(String[]) : void
}

interface Runnable

Main ..|> Runnable

' =========================
' INPUT PACKAGE
' =========================

package "input" #E8F4FD {

    class InputController {
        - inputHandler : InputHandler
        + InputController()
        + handleInput(String) : void
    }

    class InputHandler {
        - fastqFiles : List<Path>
        - samFiles : List<Path>
        - bamFiles : List<Path>
        - fastqcFiles : List<Path>
        + scanFolder(String) : void
        + getFastqFiles() : List<Path>
        + getSamFiles() : List<Path>
        + getBamFiles() : List<Path>
        + getFastqcFiles() : List<Path>
    }

    class FastQReader {
        + read(Path) : Object
    }

    class SamReader {
        + read(Path) : Object
    }

    class BamReader {
        + read(Path) : Object
    }

    class FastQCReader {
        + read(Path) : Object
    }
}

' =========================
' PROCESSING PACKAGE
' =========================

package "processing" #EAF7EA {

    class DataHandler {
        + dataHandler(List<List<String>>, boolean) : Map<String, List<String>>
    }

    class AnalyseReadQuality {
        + calculateBaseCount(int, double) : int
        + analyse(String, String, double) : QualityResult
        - validatePercentage(double) : void
        - calculateStatistics(int[]) : QualityResult.EndQuality
        - classify(double, double) : String
    }

    class DuplicateCalculator {
        + calculateDuplicates(String[]) : double
    }

    class QualityResult {
        - percentage : double
        - readLength : int
        - basesPerEnd : int
        - start : EndQuality
        - end : EndQuality
        + QualityResult(double, int, int, EndQuality, EndQuality)
        + getPercentage() : double
        + getReadLength() : int
        + getBasesPerEnd() : int
        + getStart() : EndQuality
        + getEnd() : EndQuality
    }

    class "QualityResult.EndQuality" as EndQuality {
        - meanQuality : double
        - medianQuality : double
        - minimumQuality : int
        - percentageQ20 : double
        - percentageQ30 : double
        - meanErrorProbability : double
        - classification : String
        + EndQuality(double, double, int, double, double, double, String)
        + getMeanQuality() : double
        + getMedianQuality() : double
        + getMinimumQuality() : int
        + getPercentageQ20() : double
        + getPercentageQ30() : double
        + getMeanErrorProbability() : double
        + getClassification() : String
    }

    class InvalidReadException {
        + InvalidReadException(String)
    }
}

class RuntimeException

' =========================
' OUTPUT PACKAGE
' =========================

package "output" #FFF2E2 {

    class QCResult {
        - sample : String
        - fileType : String
        - beginningQuality : Double
        - endQuality : Double
        - duplicates : Double
        - status : String
        + QCResult(String, String, Double, Double, Double, String)
        + getSample() : String
        + getFileType() : String
        + getBeginningQuality() : Double
        + getEndQuality() : Double
        + getDuplicates() : Double
        + getStatus() : String
    }

    class OutputWriter {
        + printToTerminal(List<QCResult>) : void
        + writeToFile(List<QCResult>, Path) : void
        - formatResult(QCResult) : String
        - formatPercentage(Double) : String
    }
}

' =========================
' UML RELATIES
' =========================

' Main
Main ..> InputController : gebruikt

' Input
InputController --> InputHandler : heeft
InputController ..> FastQReader : gebruikt
InputController ..> SamReader : gebruikt
InputController ..> BamReader : gebruikt
InputController ..> FastQCReader : gebruikt
InputController ..> DataHandler : start processing

' Processing pipeline
DataHandler ..> AnalyseReadQuality : stuurt data door
DataHandler ..> DuplicateCalculator : stuurt data door

' Processing intern
DataHandler ..> InvalidReadException : throws
AnalyseReadQuality ..> QualityResult : maakt
AnalyseReadQuality ..> EndQuality : maakt
QualityResult --> "2" EndQuality : start / end

' Output
OutputWriter ..> QCResult : verwerkt

' Overerving
InvalidReadException --|> RuntimeException

@enduml